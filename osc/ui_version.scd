// ============================================================
// UI version check: is the layout on the tablet the one this code expects?
// ============================================================
// Requires: ~touchOSC, ~touchOSCip (oscconfig_multi.scd), ~basePath (main_multi.scd)
// Load AFTER every tablet OSCdef is registered (oscconfig_multi.scd, presets.scd): the contract check
// below compares the layout's addresses with them.
//
// ui/ui_manifest.scd, generated by ui/build.py, holds the hash of the layout's OSC contract (addresses,
// control types, ranges). The layout's root script sends
//     /ui/hello <hash> <build>
// when it loads and whenever it gets /ui/ping. The answer
//     /ui/status <text> <ok 1|0>
// is shown in the tablet's "uiStatus" label (green = matches, red = outdated).
// A layout from before the versioning never says hello: the first message from the tablet then triggers a
// ping, and if no hello follows it is reported as unversioned.
// A mismatch only warns (post window, red label, pisound LEDs on the Pi): an outdated layout must never
// stop the patch.
// ============================================================

(
var manifest = ~basePath ++ "ui/ui_manifest.scd";
var pisoundCommon = "/usr/local/pisound/scripts/common/common.sh";

~uiContract = nil;
if (File.exists(manifest)) {
	thisProcess.interpreter.executeFile(manifest);
} {
	"UI: ui/ui_manifest.scd missing, the tablet layout cannot be checked (run: python3 ui/build.py)".warn;
};
~uiExpected = ~uiContract !? { ~uiContract[\hash] };
~uiReported = nil;     // hash the tablet reported, nil = no hello yet
~uiState    = \unknown; // \ok | \mismatch | \unversioned | \unknown
// The tablet address that serves the layout (run-sc-main_multi.sh starts the server)
~uiServeHint = "UI_HTTP_PORT".getenv;
~uiServeHint = if (~uiServeHint.notNil and: { ~uiServeHint.notEmpty } and: { ~uiServeHint != "0" }) {
	" (open http://<this machine>:" ++ ~uiServeHint ++ "/main.tosc in the tablet's browser)"
} { "" };

// Tablet addresses that need no OSCdef: the page selector and the heartbeat lamp only matter on the tablet
~uiContractIgnore = ["/pager1", "/status/heartbeat"];

// ---- Alert: three short pisound LED flashes (Pi only) ----
~uiAlert = {
	if (File.exists(pisoundCommon)) {
		Routine({
			3.do {
				("bash -c '. " ++ pisoundCommon ++ " && flash_leds 100'").unixCmd(postOutput: false);
				0.4.wait;
			};
		}).play(AppClock);
	};
};

// ---- /ui/hello <hash> <build> from the layout ----
OSCdef(\uiHello, { |msg, time, addr|
	var hash  = msg[1].asString;
	var build = msg[2].asString;
	var isNew = ~uiReported != hash;  // the layout says hello twice when it loads: post once
	~uiReported = hash;

	if (isNew and: { addr.ip != ~touchOSCip }) {
		("UI: the tablet sends from %, but SC sends to % (TOUCHOSC_IP): the tablet will show nothing."
			.format(addr.ip, ~touchOSCip)).warn;
	};

	case
	{ ~uiExpected.isNil } {
		~uiState = \unknown;
		~touchOSC.sendMsg('/ui/status', "UI " ++ hash ++ " ?", 0);
	}
	{ hash == ~uiExpected } {
		~uiState = \ok;
		~touchOSC.sendMsg('/ui/status', "UI " ++ hash, 1);
		if (isNew) { "UI: tablet layout % (build %) matches the code.".format(hash, build).postln };
	}
	{
		~uiState = \mismatch;
		~touchOSC.sendMsg('/ui/status', "UI OUTDATED " ++ hash, 0);
		if (isNew) {
			(("UI MISMATCH: the tablet runs layout % (build %), this code expects % (build %). "
				++ "Load ui/main.tosc on the tablet%.")
				.format(hash, build, ~uiExpected, ~uiContract[\build], ~uiServeHint)).warn;
			~uiAlert.();
		};
	};
}, '/ui/hello');

// ---- Older layouts: no hello at all ----
// Watches incoming messages until the first one from the tablet; then pings and waits for the hello.
~uiProbed = false;
~uiProbe = {
	if (~uiProbed.not) {
		~uiProbed = true;
		~touchOSC.sendMsg('/ui/ping');
		AppClock.sched(2.0, {
			if (~uiReported.isNil) {
				~uiState = \unversioned;
				(("UI: the tablet sends controls but no version: its layout is older than ui/main.tosc %. "
					++ "Load ui/main.tosc on the tablet%.").format(~uiExpected ? "", ~uiServeHint)).warn;
				~uiAlert.();
			};
			nil;
		});
	};
};
~uiWatcher !? { thisProcess.removeOSCRecvFunc(~uiWatcher) };
~uiWatcher = { |msg, time, addr|
	if ((addr.port != s.addr.port)
		and: { msg[0] != '/ui/hello' }
		and: { msg[0].asString.beginsWith("/polytracker/").not }) {
		// not removed from inside the receive loop itself
		AppClock.sched(0, {
			~uiWatcher !? { thisProcess.removeOSCRecvFunc(~uiWatcher); ~uiWatcher = nil };
			~uiProbe.();
			nil;
		});
	};
};
thisProcess.addOSCRecvFunc(~uiWatcher);

// ---- Contract check: does every tablet control have an OSCdef? ----
~uiCheckContract = {
	var handled, unhandled;
	if (~uiContract.notNil) {
		handled = Set.new;
		OSCdef.all.do { |def| def.path !? { handled.add(def.path.asString) } };
		unhandled = ~uiContract[\sends].reject { |path|
			handled.includes(path) or: { ~uiContractIgnore.includesEqual(path) }
		};
		if (unhandled.isEmpty) {
			"UI contract %: every tablet control has an OSCdef.".format(~uiExpected).postln;
		} {
			("UI contract %: no OSCdef for %".format(~uiExpected, unhandled.join(", "))).warn;
		};
	};
};
~uiCheckContract.();

// ---- Ask an already open layout for its version ----
~touchOSC.sendMsg('/ui/ping');
"UI version check ready (expects layout %).".format(~uiExpected ? "?").postln;
)
