            <!-- Status Label -->
            <node type="LABEL">
              <property name="name" type="s">Status</property>
              <property name="tag" type="s">/chaos/status</property>
              <property name="frame" type="r">0.02 0.71 0.96 0.08</property>
              <property name="color" type="c">0.6 0.9 0.6 1.0</property>
              <property name="text" type="s">Ready</property>
              <property name="z" type="i">1</property>
              <children/>
