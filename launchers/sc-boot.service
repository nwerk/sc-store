[Unit]
Description=SuperCollider granular patch (sc-store)
# Replace jack.service below with whatever owns jackd on your system
# Check with: systemctl status $(ps -o unit= -p <jackd-pid>)
After=sound.target jack.service
Wants=jack.service

[Service]
User=patch
Environment=JACK_NO_AUDIO_RESERVATION=1
ExecStart=/usr/local/sc-patches/boot-sc.sh
# Restart if sclang crashes; give Jack time to settle after a crash
Restart=on-failure
RestartSec=10

# Keep logs readable
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sc-boot

[Install]
WantedBy=multi-user.target
